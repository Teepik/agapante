# --- Base de données (obligatoire pour le formulaire et le back-office) ---
# Créée automatiquement en ajoutant une base Postgres (Neon) depuis
# Vercel → projet agapante → onglet Storage.
DATABASE_URL=

# --- Accès au back-office /admin (obligatoire) ---
ADMIN_PASSWORD=

# Jeton pour réinitialiser le mot de passe via /admin/configurer?jeton=...
# Facultatif : un jeton de secours intégré permet la première configuration.
ADMIN_BOOTSTRAP_TOKEN=

# Clé utilisée pour signer le cookie de session et hacher les adresses IP.
# Générer avec : openssl rand -base64 32
SESSION_SECRET=

# --- Stockage des images vitrine (recommandé pour /admin/vitrine) ---
# Créez un store Blob depuis Vercel → projet agapante → onglet Storage.
BLOB_READ_WRITE_TOKEN=

# --- URL publique du site (recommandé) ---
# Sert aux URL canoniques, au sitemap et aux images Open Graph.
NEXT_PUBLIC_SITE_URL=https://agapante.vercel.app

# --- Notification e-mail à chaque nouvelle demande (facultatif) ---
# Sans ces variables, les demandes restent consultables dans /admin.
RESEND_API_KEY=
NOTIFICATION_EMAIL=
NOTIFICATION_FROM=Agapante <onboarding@resend.dev>

# --- Anti-robot Cloudflare Turnstile (recommandé en production) ---
# Sans ces clés, le formulaire s'appuie sur honeypots, délais et filtres heuristiques.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
